# Copy to .env and fill in. Never prefix a secret with VITE_ — that ships it to
# the browser.

# Supabase (VITE_* pair is the client build-time copy)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-only. Required: lesson completion and the AI mentor write through it.
SUPABASE_SERVICE_ROLE_KEY=

# AI mentor -------------------------------------------------------------------
# anthropic | openai | deepseek | gemini | mock
# "mock" (the default when unset) uses the scripted mentor and needs no key.
MENTOR_PROVIDER=mock
# Optional override; each provider has a sensible default model.
MENTOR_MODEL=

# Set the one matching MENTOR_PROVIDER.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Optional base-URL overrides (self-hosted or proxied endpoints).
OPENAI_BASE_URL=
DEEPSEEK_BASE_URL=
GEMINI_BASE_URL=

# Plan enforcement ------------------------------------------------------------
# "false" (default) unlocks everything for everyone — the flag to flip once
# there is enough content for a Free tier to be worth having.
VITE_ENTITLEMENTS_ENABLED=false
ENTITLEMENTS_ENABLED=false

# Payments --------------------------------------------------------------------
# mock | stripe. "mock" applies the plan server-side without charging anything.
PAYMENTS_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_LIFETIME=

# Certificates ----------------------------------------------------------------
# Signs certificates so a printed one can be verified at /verify/<id>.
# Falls back to SUPABASE_SERVICE_ROLE_KEY when unset; set it explicitly if you
# ever rotate that key, or every signature issued before the rotation stops
# verifying (the issuing record stays valid either way).
CERTIFICATE_SIGNING_SECRET=

# Re-engagement email ---------------------------------------------------------
# mock | resend. "mock" logs the message instead of sending it.
EMAIL_PROVIDER=mock
RESEND_API_KEY=
# Must be a verified sender on your provider, e.g. "Ascent <hello@example.com>"
EMAIL_FROM=
# Public origin, used for links inside emails.
APP_URL=http://localhost:5173
# Shared secret for POST /api/cron/reengagement. No secret set = endpoint 401s.
CRON_SECRET=

# Web push reminders — generate with `bun run push:keys`. Unset = the profile
# toggle is hidden and every nudge goes by email. Rotating the pair drops every
# existing browser subscription. The private key is server-only.
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Code runner -----------------------------------------------------------------
# Where Pyodide (CPython in WebAssembly) is loaded from. Leave unset to use the
# public CDN; set it to a self-hosted copy to run Python challenges offline.
VITE_PYODIDE_URL=
